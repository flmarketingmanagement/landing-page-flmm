{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1160px",
			"wideSize": "1160px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "base", "name": "Hueso", "color": "#F4F2EE" },
				{ "slug": "surface", "name": "Superficie", "color": "#ECE9E4" },
				{ "slug": "card", "name": "Tarjeta", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Carbón", "color": "#303030" },
				{ "slug": "ink-2", "name": "Texto secundario", "color": "#5F5B58" },
				{ "slug": "muted", "name": "Texto tenue", "color": "#6B6662" },
				{ "slug": "line", "name": "Línea", "color": "#DCD8D2" },
				{ "slug": "accent", "name": "Rosa (acento)", "color": "#FF78A8" },
				{ "slug": "dark", "name": "Oscuro", "color": "#303030" },
				{ "slug": "on-dark", "name": "Texto sobre oscuro", "color": "#F4F2EE" },
				{ "slug": "on-dark-2", "name": "Texto tenue sobre oscuro", "color": "#A8A39F" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"letterSpacing": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Geist",
					"fontFamily": "Geist, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Geist-Variable.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Geist Mono",
					"fontFamily": "\"Geist Mono\", ui-monospace, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/GeistMono-Variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Etiqueta", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "Pequeño", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Base", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Entrada", "size": "1.25rem", "fluid": { "min": "1.05rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Título 3", "size": "2rem", "fluid": { "min": "1.4rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Título 2", "size": "3.6rem", "fluid": { "min": "2.1rem", "max": "3.6rem" } },
				{ "slug": "huge", "name": "Título 1", "size": "4.8rem", "fluid": { "min": "2.4rem", "max": "4.8rem" } },
				{ "slug": "giant", "name": "Hero", "size": "6.4rem", "fluid": { "min": "2.75rem", "max": "6.4rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "1.5rem" },
				{ "slug": "40", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "Sección", "size": "clamp(4.5rem, 10vw, 8rem)" }
			]
		},
		"border": {
			"radius": true,
			"radiusSizes": [
				{ "slug": "small", "name": "Pequeño", "size": "14px" },
				{ "slug": "medium", "name": "Tarjeta", "size": "18px" },
				{ "slug": "pill", "name": "Píldora", "size": "999px" }
			]
		},
		"custom": {
			"gutter": "clamp(1.25rem, 4vw, 2.5rem)",
			"radius": {
				"card": "18px",
				"small": "14px",
				"pill": "999px"
			},
			"header-height": "76px",
			"prose-width": "68ch"
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "inherit" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } },
				":focus-visible": {
					"outline": { "color": "var(--wp--preset--color--accent)", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "500",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.02"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "1.3rem", "letterSpacing": "-0.02em", "lineHeight": "1.25" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "999px", "width": "0" },
				"spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.35rem", "right": "1.35rem" } },
				"typography": { "fontSize": "0.9375rem", "fontWeight": "500", "lineHeight": "1" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":focus-visible": {
					"outline": { "color": "var(--wp--preset--color--accent)", "offset": "2px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": { "margin": { "top": "0", "bottom": "0" } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" },
				"border": { "width": "1px 0 0 0" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/quote": {
				"border": { "width": "0" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.35", "letterSpacing": "-0.02em" }
			},
			"core/post-title": {
				"typography": { "fontWeight": "500" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			},
			"core/details": {
				"border": { "bottom": { "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-service", "title": "Servicio", "postTypes": [ "page" ] },
		{ "name": "page-landing", "title": "Landing (sin título)", "postTypes": [ "page" ] }
	]
}
